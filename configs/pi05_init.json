{
  "method": "baseline",
  "tau_clean": 0,
  "checkpoint": "data/pretrained/pi05_libero_starvla/fp32/model.safetensors",
  "tokenizer": "data/paligemma_tokenizer.model",
  "data_config": "configs/data.json",
  "manifest": "manifests/training_current.json.gz",
  "validation_receipt": "data/validation_pi05_baseline.json",
  "run_dir": "runs/pi05_init",
  "seed": 42,
  "world_size": 8,
  "batch_size": 16,
  "max_steps": 10000,
  "warmup_steps": 1500,
  "lr": 1e-05,
  "min_lr": 1e-05,
  "lr_schedule": "constant",
  "weight_decay": 1e-10,
  "betas": [
    0.9,
    0.95
  ],
  "eps": 1e-08,
  "grad_clip": 1,
  "samples_per_epoch": 320000,
  "sampling_block_size": 32,
  "sampling_weights": {
    "success": 40,
    "recovery": 20
  },
  "num_workers": 0,
  "cache_episodes": 2,
  "save_steps": [
    10,
    10000
  ],
  "save_interval": 5000,
  "gradient_checkpointing": true,
  "ss_loss_weight": 1,
  "fs_loss_weight": 1,
  "ss_no_padding_weight": 0.1
}
